rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidHistoryItem(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'timestamp', 'tabId', 'tabLabel'])
        && data.id is string
        && data.id.size() <= 128
        && data.userId == userId
        && data.timestamp is number
        && data.tabId is string
        && data.tabId.size() <= 64
        && data.tabLabel is string
        && data.tabLabel.size() <= 128;
    }

    match /users/{userId} {
      match /history/{historyId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(historyId)
          && isValidHistoryItem(incoming(), userId);
        allow delete: if isOwner(userId);
      }
    }
  }
}
